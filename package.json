{
  "name": "svelte-lens-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@gear-null/svelte-lens --filter=@svelte-lens/e2e-app",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint packages apps .github/scripts",
    "format": "prettier --write \"**/*.{ts,js,svelte,json,md}\" && prettier --write \".github/scripts/*.mjs\"",
    "format:check": "prettier --check \"**/*.{ts,js,svelte,json,md}\" && prettier --check \".github/scripts/*.mjs\"",
    "test": "turbo run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:ci": "node --test .github/scripts/*.test.mjs",
    "test:security": "node .github/scripts/ci-semgrep.mjs",
    "quality:install": "node .github/scripts/local-quality.mjs --install",
    "quality:staged": "node .github/scripts/local-quality.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "oxlint": "1.61.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.22.1 || >=26",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": "^0.28.1",
      "@sveltejs/kit@2>cookie": "^0.7.2"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
